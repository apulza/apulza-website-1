{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apulza-website",
  "account_id": "77152d7bda3e22c4b6cf16dd2860346e",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Beta sign-ups. For local dev the id below is a placeholder; after running
  // `npx wrangler d1 create apulza-beta`, replace it with the real database_id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apulza-beta",
      "database_id": "248c21ab-98f3-4228-a4f9-ed922b61bf6f",
      "migrations_dir": "migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
